{
  "name": "modulartess-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Panel administrativo privado de Modulartess.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:update": "node scripts/api-contract.mjs update",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "google-auth-library": "^11.0.2",
    "next": "16.3.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}

# Configuración de despliegue del panel en Cloud Run (staging).
#
# Este archivo SÍ se versiona: no contiene secretos. Son identificadores de infraestructura, todos
# públicos o deducibles, y tenerlos fijos aquí evita que un despliegue dependa de lo que alguien
# recuerde escribir en la línea de comandos.
#
# Lo que NO vive aquí: los valores de Firebase (identificadores públicos del cliente, pero sin
# versionar) y cualquier credencial. Ver `deploy/README.md`.

PROJECT_ID=modulartessweb-250f5
REGION=us-east1

# --- Panel administrativo (este repositorio) ---
SERVICE_NAME=modulartess-admin-staging
AR_REPOSITORY=modulartess
IMAGE_NAME=modulartess-admin
RUNTIME_SERVICE_ACCOUNT=modulartess-admin-stg-run@modulartessweb-250f5.iam.gserviceaccount.com

# --- Backend al que llama el BFF ---
# `MODULARTESS_BACKEND_URL` y `MODULARTESS_BACKEND_AUDIENCE` deben ser el MISMO origen canónico:
# el panel lo exige en `readBackendConfig` y una audiencia distinta produce un identity token que
# Cloud Run rechaza.
BACKEND_SERVICE_NAME=modulartess-backend-staging
BACKEND_URL=https://modulartess-backend-staging-eiccfp227q-ue.a.run.app
BACKEND_AUDIENCE=https://modulartess-backend-staging-eiccfp227q-ue.a.run.app
BACKEND_AUTH_MODE=google-oidc

# --- Origen autorizado para las rutas mutantes del BFF ---
#
# El dominio administrativo canónico, servido por el Load Balancer externo (IP global, NEG
# serverless y certificado gestionado; ver `deploy/README.md`). Es el único `Origin` que aceptan
# las rutas mutantes del BFF, y `preflight` exige este valor exacto: ni otro dominio, ni la URL de
# Cloud Run, ni una barra final.
ADMIN_ORIGIN=https://admin.modulartess.com

# Número del proyecto, para calcular la URL determinista de Cloud Run
# (https://<servicio>-<numero-de-proyecto>.<region>.run.app). Esa URL ya **no** es una entrada:
# `preflight` la rechaza como origen y `verify` comprueba si todavía responde desde internet.
PROJECT_NUMBER=651080070961

# --- Recursos del servicio ---
SERVICE_PORT=8080
SERVICE_CPU=1
SERVICE_MEMORY=512Mi
SERVICE_CONCURRENCY=40
SERVICE_TIMEOUT=60s
SERVICE_MIN_INSTANCES=0
SERVICE_MAX_INSTANCES=1
SERVICE_EXECUTION_ENVIRONMENT=gen1
SERVICE_INGRESS=all

# APIs que el despliegue necesita. El script las comprueba pero NUNCA las habilita.
REQUIRED_APIS="run.googleapis.com artifactregistry.googleapis.com cloudbuild.googleapis.com iam.googleapis.com"
